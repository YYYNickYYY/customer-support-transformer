{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "核验第六次学习率实验（不训练）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-X", "utf8", "-m", "my_project_1.training_sixth", "--config", "configs/training-sixth.json", "--check"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "第六次训练（仅学习率0.0001，5轮，全新初始化）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-X", "utf8", "-m", "my_project_1.training_sixth", "--config", "configs/training-sixth.json", "--train"],
      "dependsOn": "核验第六次学习率实验（不训练）",
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "核验第五次冻结清单（不训练）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-X", "utf8", "-m", "my_project_1.target_revision_v31", "--verify"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "第五次训练（v3退款执行承诺整句改写，5轮）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-X", "utf8", "-m", "my_project_1.training_fifth_final", "--config", "configs/training-fifth-final.json"],
      "dependsOn": "核验第五次冻结清单（不训练）",
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "核验第四次冻结清单（不训练）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.target_revision_v2", "--verify"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "第四次训练（v2整句保证话术干预，5轮）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.training", "--config", "configs/training-fourth.json"],
      "dependsOn": "核验第四次冻结清单（不训练）",
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "查看第三次训练进度（只看日志，不启动训练）",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "$env:PSModulePath = ($env:PSModulePath -split ';' | Where-Object { $_ -and $_ -notlike '*\\codex-runtimes\\*' }) -join ';'; Write-Host '只显示后台训练日志。Ctrl+C停止查看，不停止训练。'; Get-Content -LiteralPath '${workspaceFolder}/outputs/third-training-20261005/stdout.log' -Encoding UTF8 -Tail 40 -Wait"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "第三次训练（冻结保证话术干预，5轮）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.training", "--config", "configs/training-third.json"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "固定 dev 检查（批量生成 + 人工评分表）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.dev_check"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "全量 train 训练 + dev 评估（5轮，耗时较长）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.training"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "训练流程检查（16条 train + 16条 dev）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.training", "--smoke-test"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "生成回复（全量训练最佳模型，4条train问题）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.generate"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "少量真实样本训练（CPU，120步）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.overfit"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "完整模型检查（无需调试器）",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "-m", "my_project_1.model", "--device", "cpu"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
